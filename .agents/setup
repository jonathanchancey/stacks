#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

nix_profile="$HOME/.nix-profile"
tools_profile="$HOME/.local/state/stacks/orb-tools"
venv="$repo_root/tools/.venv"
dev_env="$HOME/.local/state/stacks/dev-env.sh"

write_block() {
  local file="$1" marker="$2" content="$3"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  sed -i "/^$marker begin\$/,/^$marker end\$/d" "$file"
  printf '%s begin\n%s\n%s end\n' "$marker" "$content" "$marker" >>"$file"
}

install_nix() {
  if [[ ! -x "$nix_profile/bin/nix" ]]; then
    sudo install -d -o "$(id -u)" -g "$(id -g)" /nix
    curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon --no-modify-profile --yes
  fi
  mkdir -p "$HOME/.config/nix"
  local conf="$HOME/.config/nix/nix.conf"
  grep -Fqx "experimental-features = nix-command flakes" "$conf" 2>/dev/null ||
    echo "experimental-features = nix-command flakes" >>"$conf"
}

build_dev_shell() {
  mkdir -p "$(dirname "$dev_env")"
  nix print-dev-env --no-update-lock-file "$repo_root" >"$dev_env.tmp"
  mv "$dev_env.tmp" "$dev_env"
}

build_orb_tools() {
  mkdir -p "$(dirname "$tools_profile")"
  nix build --impure --no-update-lock-file --profile "$tools_profile" --expr "
    let
      flake = builtins.getFlake \"git+file://$repo_root\";
      pkgs = flake.inputs.nixpkgs.legacyPackages.\${builtins.currentSystem};
    in
    pkgs.buildEnv {
      name = \"stacks-orb-tools\";
      paths = with pkgs; [
        age
        cloudflared
        fluxcd
        kubeconform
        kubectl
        kubernetes-helm
        kustomize
        sops
        talosctl
        yq-go
      ];
    }"
}

install_flux_local() {
  local version
  version="$(sed -n 's|.*ghcr.io/allenporter/flux-local:v\([0-9.]*\).*|\1|p' .github/workflows/flux-diff.yaml | head -n1)"
  [[ -x "$venv/bin/python" ]] || uv venv --quiet --python 3.13 "$venv"
  uv pip install --quiet --python "$venv/bin/python" "flux-local==$version"
}

persist_environment() {
  write_block "$HOME/.bash_profile" "# stacks orb development environment" "\
if [[ -e \"$nix_profile/etc/profile.d/nix.sh\" ]]; then
  . \"$nix_profile/etc/profile.d/nix.sh\"
fi
if [[ -z \"\${IN_NIX_SHELL:-}\" && -r \"$dev_env\" && ( \"\$PWD\" == \"$repo_root\" || \"\$PWD\" == \"$repo_root\"/* ) ]]; then
  __stacks_tmpdir=\"\${TMPDIR-}\"
  . \"$dev_env\"
  rm -rf -- \"\$NIX_BUILD_TOP\"
  unset NIX_BUILD_TOP TMP TEMP TEMPDIR
  if [[ -n \"\$__stacks_tmpdir\" ]]; then export TMPDIR=\"\$__stacks_tmpdir\"; else unset TMPDIR; fi
  unset __stacks_tmpdir
  export PATH=\"$tools_profile/bin:\$PATH\"
  if [[ -r \"\$HOME/.kube/stacks-orb.json\" ]]; then
    export KUBECONFIG=\"\$HOME/.kube/stacks-orb.json\"
  fi
fi"
}

write_agent_guidance() {
  write_block "$HOME/.config/amp/AGENTS.md" "<!-- stacks orb toolchain -->" "\
# stacks orb toolchain

- login shells in the repository load the nix dev shell and orb tools, including cloudflared and kubectl.
- the dev shell environment is cached; rerun \`.agents/setup\` after editing \`flake.nix\` or \`flake.lock\`.
- flux-local is installed in \`tools/.venv\`, matching the version in \`.github/workflows/flux-diff.yaml\`.
- \`.agents/resume\` configures read-only bastille access through a private cloudflare tunnel when project credentials are present. kubectl refreshes thread-scoped workload identity tokens automatically; no talos api access is granted.
- without project credentials, pass \`CLUSTER=bastille NAMESPACE=default\` to offline tasks."
}

step "install nix" install_nix
# shellcheck disable=SC1091
source "$nix_profile/etc/profile.d/nix.sh"
step "build dev shell" build_dev_shell
step "build orb tools" build_orb_tools
step "install flux-local" install_flux_local
step "persist environment" persist_environment
step "write agent guidance" write_agent_guidance
