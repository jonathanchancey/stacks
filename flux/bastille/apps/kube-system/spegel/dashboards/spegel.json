{
  "uid": "1iY4QMJVk-psee",
  "title": "spegel",
  "schemaVersion": 39,
  "tags": [
    "spegel"
  ],
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(spegel_advertised_keys{job=\"spegel\"},pod)",
          "refId": "pod"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "all",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "spegel instances",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(spegel_advertised_keys{job=\"spegel\",pod=~\"$pod\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "advertised keys",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "spegel_advertised_keys{job=\"spegel\",pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "mirror requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(spegel_mirror_requests_total{job=\"spegel\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "cache hit ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(spegel_mirror_requests_total{job=\"spegel\",pod=~\"$pod\",cache=\"hit\"}[$__rate_interval])) / sum(rate(spegel_mirror_requests_total{job=\"spegel\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "p99 peer resolution",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, router) (rate(spegel_resolve_duration_seconds_bucket{job=\"spegel\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{router}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "memory usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"spegel\",pod=~\"$pod\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
