{
  "uid": "talos",
  "title": "talos",
  "description": "node versions, control-plane scrape health, and talos log delivery.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "talos"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "etcd",
      "type": "link",
      "url": "/d/c2f4e12cdf69feb95caa41a5a1b423d9",
      "keepTime": true
    },
    {
      "title": "scheduler",
      "type": "link",
      "url": "/d/2e6b6a3b4bddf1427b3a55aa1311c656",
      "keepTime": true
    },
    {
      "title": "controller-manager",
      "type": "link",
      "url": "/d/72e0e05bef5099e5f049b05fdc429ed4",
      "keepTime": true
    },
    {
      "title": "nodes",
      "type": "link",
      "url": "/d/7d57716318ee0dddbac5a7f451fb7753",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "control-plane scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"kube-etcd|kube-controller-manager|kube-scheduler\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "etcd detail panels require successful etcd scraping. a down target indicates a collection problem before dashboard queries are evaluated."
    },
    {
      "id": 2,
      "title": "log collector scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"observability\",pod=~\"talos-.+\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "node versions",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_node_info{os_image=~\"Talos.*\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "node",
                "os_image",
                "kernel_version",
                "kubelet_version",
                "container_runtime_version"
              ]
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "node",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "logs received",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(vector_component_received_events_total{namespace=\"observability\",pod=~\"talos-.+\",component_id=\"talos\"}[$__rate_interval]))",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "log delivery errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(vector_component_errors_total{namespace=\"observability\",pod=~\"talos-.+\",component_id=\"loki\"}[$__rate_interval])) or on (node) (0 * max by (node) (up{namespace=\"observability\",pod=~\"talos-.+\"}))",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "log buffer usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (vector_buffer_size_bytes{namespace=\"observability\",pod=~\"talos-.+\",component_id=\"loki\"}) / sum by (node) (vector_buffer_max_size_bytes{namespace=\"observability\",pod=~\"talos-.+\",component_id=\"loki\"})",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    }
  ]
}
