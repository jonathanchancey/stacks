{
  "uid": "bastille-thermals",
  "title": "bastille thermals",
  "description": "all exposed hardware sensor values from bastille talos nodes.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "talos",
    "hardware",
    "thermals"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\"}, kubernetes_node)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "sentinel-0[0-2]",
        "current": {
          "text": "all",
          "value": "$__all"
        }
      },
      {
        "name": "metric",
        "label": "detail metric",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values({job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\",__name__=~\"node_hwmon_.*|node_thermal_zone_.*|node_cooling_device_.*|node_cpu_(core|package)_throttles_total\"}, __name__)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "node_hwmon_temp_celsius",
          "value": "node_hwmon_temp_celsius"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "exporters",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\"}",
          "legendFormat": "{{kubernetes_node}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "sensor collectors",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "min by (kubernetes_node) (node_scrape_collector_success{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\",collector=~\"hwmon|thermal_zone\"})",
          "legendFormat": "{{kubernetes_node}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
