    {
      "id": 5,
      "type": "text",
      "title": "reading the sensors",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "all exposed values are retained, including zero and negative readings. motherboard inputs can be unwired or uncalibrated; a reported value alone does not establish a real component temperature. thermal zones may duplicate cpu package sensors. hardware limits and alarm flags are reported as supplied by the driver. use the node selector to compare machines, and the metric selector for the detail chart."
      }
    },
    {
      "id": 6,
      "title": "cpu temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "description": "package and individual core sensors, with driver-provided labels.",
      "targets": [
        {
          "refId": "A",
          "expr": "(node_hwmon_temp_celsius{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\",chip=~\".*coretemp.*|.*k10temp.*|.*zenpower.*\"} * on(instance, chip, sensor) group_left(label) node_hwmon_sensor_label{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\"}) or on(instance, chip, sensor) node_hwmon_temp_celsius{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\",chip=~\".*coretemp.*|.*k10temp.*|.*zenpower.*\"}",
          "legendFormat": "{{kubernetes_node}} / {{chip}} / {{sensor}} {{label}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
