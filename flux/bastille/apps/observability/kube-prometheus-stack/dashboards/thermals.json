        {
          "refId": "A",
          "expr": "count by (kubernetes_node) (node_hwmon_temp_celsius{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\"} or node_thermal_zone_temp{job=\"node-exporter\",kubernetes_node=~\"sentinel-0[0-2]\",kubernetes_node=~\"${node:regex}\"})",
          "legendFormat": "{{kubernetes_node}}",
