{
  "storage": {
    "type": "filesystem",
    "config": {
      "path": "/repository"
    }
  },
  "hostname": "storage",
  "username": "verification",
  "description": "Read-only verification of all VolSync backups",
  "enableActions": false,
  "readonly": true,
  "caching": {
    "cacheDirectory": "/cache",
    "maxCacheSize": 268435456,
    "contentCacheSizeLimitBytes": 536870912,
    "maxMetadataCacheSize": 536870912,
    "metadataCacheSizeLimitBytes": 1073741824
  }
}
